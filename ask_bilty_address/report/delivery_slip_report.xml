<odoo>
    <template id="report_bilty_deliveryslip_inherit" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col-4" t-if="o.partner_id and o.partner_id.bilty_address">
                <strong>Logistics Address</strong><br/>
                <span t-field="o.partner_id.bilty_address"/>
            </div>
        </xpath>
    </template>
    <template id="report_bilty_deliveryslip_two_boxes" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='signature']" position="after">
            <div class="row mt-3">
                <div class="col-4">
                    <strong>Total Quantity:</strong>
                    <span t-esc="sum(o.move_line_ids.mapped('quantity'))"/>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-start" style="gap:80px;">
                    <div style="border:1px solid #000; padding:12px; min-height:115px; width:230px;">
                        <strong>Checker</strong>
                    </div>
                    <div style="border:1px solid #000; padding:12px; min-height:115px; width:230px;">
                        <strong>Packer</strong>
                    </div>
                    <div style="border:1px solid #000; padding:12px; min-height:115px; width:230px;">
                        <strong>Signature</strong>
                    </div>
                </div>
            </div>
        </xpath>
    </template>



    <!-- Custom Report Action -->
    <record id="action_report_bilty_deliveryslip" model="ir.actions.report">
        <field name="name">Logistics Delivery Slip</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <!-- point to wrapper template of stock -->
        <field name="report_name">stock.report_deliveryslip</field>
        <field name="report_file">stock.report_deliveryslip</field>
        <field name="print_report_name">'Delivery Slip - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
</odoo>